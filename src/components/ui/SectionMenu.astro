---
import { cloudinaryUrl, cloudinarySrcset } from '../../utils/cloudinary';

interface Dish {
  title: string;
  description: string;
  ctaLabel: string;
  ctaHref?: string;
  image?: string;
  imageAlt?: string;
  reverse?: boolean;
}

interface Props {
  title?: string;
  dishes?: Dish[];
}

const {
  title = 'Tego musisz spróbować',
  dishes = [
    {
      image: 'riverside-dym-ogien-gdansk-sekcja-menu-golonka',
      title: 'Wolno gotowana golonka',
      description: 'Golonka pieczona 12 godzin – miękka, soczysta, rozpada się przy pierwszym ruchu.',
      ctaLabel: 'Z czym ją serwujemy',
      reverse: false,
    },
    {
      image: 'riverside-dym-ogien-gdansk-sekcja-menu-zeberka',
      title: 'Żeberka pieczone BBQ',
      description: 'Żeberka BBQ – wolno pieczone, w autorskim sosie, dokładnie takie, jakie mają być.',
      ctaLabel: 'Jak je podajemy',
      reverse: true,
    },
    {
      image: 'riverside-dym-ogien-gdansk-sekcja-menu-burger',
      title: 'Cheesy Bacon Burger',
      description: 'Soczyste, delikatne mięso z wyczuwalną nutą dymu, autorskie sosy i składniki. Każdy kęs to konkretny smak.',
      ctaLabel: 'Z jakimi dodatkami',
      reverse: false,
    },
  ],
} = Astro.props;

const MENU_HREF = '/menu';
---

<section class="section-py">
  <div class="container px-4 mx-auto">
    <h2 class="section-heading mb-20">
      {title}
    </h2>

    <div class="space-y-6">
      {dishes.map(({ title: dishTitle, description, ctaLabel, ctaHref = MENU_HREF, image, imageAlt = '', reverse = false }) => {
        const photoSrc = image ? cloudinaryUrl(image, { width: 700, aspectRatio: '4:3', crop: 'fill' }) : null;
        const photoSrcset = image ? cloudinarySrcset(image, [500, 700, 900], { aspectRatio: '4:3', crop: 'fill' }) : null;

        return (
          <div class="pt-20 pb-10 lg:pt-10 px-10 max-w-xl lg:max-w-none mx-auto border border-glass-border rounded-3xl shadow-xl shadow-black/40">
            <div class:list={['flex flex-wrap -mx-4 items-center', reverse ? 'flex-row-reverse' : '']}>

              <div class="w-full lg:w-7/12 px-4 mb-12 lg:mb-0">
                <div class="max-w-sm xl:max-w-lg mx-auto">
                  <h3 class="text-4xl tracking-tight mb-6 text-glass-white">{dishTitle}</h3>
                  <p class="prose-p max-w-md mb-10">{description}</p>
                  <a
                    href={ctaHref}
                    class="group inline-flex py-5 px-8 items-center justify-center leading-none font-medium text-glass-white bg-glass-accent-amber hover:bg-glass-accent-glow rounded-full transition-colors duration-200"
                  >
                    <span class="mr-2">{ctaLabel}</span>
                    <span class="group-hover:rotate-45 transform transition duration-100">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path fill-rule="evenodd" d="M14 2.5a.5.5 0 0 0-.5-.5h-6a.5.5 0 0 0 0 1h4.793L2.146 13.146a.5.5 0 0 0 .708.708L13 3.707V8.5a.5.5 0 0 0 1 0v-6z"/>
                      </svg>
                    </span>
                  </a>
                </div>
              </div>

              <div class="w-full lg:w-5/12">
                {image ? (
                  <div class="relative rounded-3xl overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-t from-glass-accent-amber/30 via-transparent to-glass-black/20 pointer-events-none"></div>
                    <img
                      class="block w-full rounded-3xl"
                      src={photoSrc}
                      srcset={photoSrcset}
                      sizes="(min-width: 1024px) 42vw, 100vw"
                      alt={imageAlt}
                      aria-hidden={imageAlt ? undefined : 'true'}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ) : (
                  <div
                    class="flex aspect-[4/3] items-center justify-center bg-glass-anthracite border border-glass-border rounded-3xl"
                    role="img"
                    aria-label={imageAlt || 'Zdjęcie wkrótce'}
                  >
                    <svg class="w-12 h-12 text-glass-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5h16v14H4V5zm0 14 5-6 3 3 4-5 4 4M9 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
                    </svg>
                  </div>
                )}
              </div>

            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
